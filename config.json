{
  "app": {
    "db_path": "data/lead_pipeline.db",
    "target_country": "US",
    "log_level": "INFO",
    "excluded_domains": [
      "facebook.com",
      "instagram.com",
      "linkedin.com",
      "twitter.com",
      "x.com",
      "yelp.com",
      "yellowpages.com",
      "youtube.com",
      "tiktok.com"
    ]
  },
  "queue": {
    "daily_queue_size": 35,
    "base_scores": {
      "dead_domain_score": 5.0,
      "no_website_score": 4.0,
      "max_review_bonus": 5.0,
      "min_phone_digits": 10,
      "exclude_toll_free_from_outreach": true,
      "toll_free_penalty": -3.0
    },
    "required_outreach_fields": {
      "require_business_name": true,
      "require_completed_audit": true,
      "at_least_one_contact": [
        "dm_email",
        "generic_email",
        "clean_phone",
        "form_url",
        "facebook_url",
        "instagram_url",
        "whatsapp_url"
      ]
    },
    "ranking_weights": {
      "broken_mobile": 3.0,
      "missing_lead_capture": 2.5,
      "unclickable_phone": 2.0,
      "slow_load": 1.5,
      "server_delay": 1.5,
      "high_ttfb": 1.5,
      "heavy_page": 1.0,
      "builder_bloat": 1.0,
      "thin_architecture": 1.5,
      "content_starved": 1.0,
      "zero_visual_proof": 1.5,
      "obstructive_sticky_header": 2.0,
      "obstructive_header": 2.0,
      "zero_trust_anchors": 1.5,
      "bot_challenge_gated": 1.5,
      "render_incomplete": 1.5,
      "no_website": 4.0,
      "has_email_bonus": 2.0,
      "has_mobile_phone_bonus": 1.5,
      "has_whatsapp_bonus": 1.5,
      "review_count_factor": 0.02
    }
  },
  "scraper_c1": {
    "browser_channel": "chrome",
    "headless": true,
    "user_data_dir": "./data/chrome_lead_profile",
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "launch_args": [
      "--disable-blink-features=AutomationControlled",
      "--no-sandbox",
      "--disable-infobars",
      "--disable-dev-shm-usage",
      "--disable-browser-side-navigation",
      "--disable-features=IsolateOrigins,site-per-process",
      "--window-size=1920,1080"
    ],
    "target_queries": [
      "commercial roofer Dallas TX",
      "commercial roofer Plano TX"
    ],
    "max_results_per_query": 50,
    "max_consecutive_empty_scrolls": 5,
    "scroll_delay_min_ms": 1200,
    "scroll_delay_max_ms": 2800,
    "navigation_timeout_ms": 30000,
    "detail_pane_timeout_ms": 2500,
    "scroll_amount_px": 450,
    "search_url_template": "https://www.google.com/maps/search/{query}?hl=en",
    "default_phone_prefix": "+1",
    "query_cooldown_min_ms": 2500,
    "query_cooldown_max_ms": 5000,
    "lead_origin": "c1_google_maps",
    "geo_grid": {
      "enabled": false,
      "center_lat": 32.7767,
      "center_lon": -96.7970,
      "grid_size": 2,
      "step_deg": 0.04,
      "geo_zoom": 13
    },
    "selectors": {
      "consent_accept_buttons": [
        "button[aria-label*='Accept all']",
        "form[action*='consent'] button",
        "button[aria-label*='Agree']"
      ],
      "feed_container": "div[role='feed']",
      "single_result_container": "div[role='main']",
      "card_place_link": "a[href*='/maps/place/'], a.hfpxzc",
      "listing_card": "div[role='feed'] div.Nv2PK, div[role='feed'] div[role='article']",
      "business_name": ".qBF1Pd, div.fontHeadlineSmall",
      "rating_aria": "span[role='img'][aria-label*='stars'], span[aria-label*='stars']",
      "review_count": "span.UY7F9, span[aria-label*='reviews'], span[aria-label*='review']",
      "website_button": "a[data-value='Website'], a[aria-label*='website' i], a[aria-label*='Website']",
      "phone_button": "span.UsdlK, button[data-tooltip*='phone'], button[data-item-id*='phone']",
      "phone_button_aria": "button[aria-label*='Phone:' i]",
      "card_click_anchor": "a.hfpxzc",
      "detail_pane_title": "h1.DUwDvf",
      "detail_pane_website": "a[data-item-id='authority'], a[aria-label*='Website' i], a[aria-label*='website' i]",
      "detail_pane_phone": "[data-item-id^='phone:tel:'], button[aria-label*='Phone:' i], [data-tooltip*='Copy phone']",
      "detail_pane_phone_aria": "button[aria-label*='Phone:' i]",
      "end_of_list_marker": "div[role='feed'] span.HlvSq, div[role='feed'] p.fontBodyMedium:has-text('end of the list'), span.HlvSq"
    }
  },
  "auditor": {
    "concurrency_limit": 5,
    "headless_args": [
      "--disable-gpu",
      "--no-sandbox",
      "--disable-dev-shm-usage"
    ],
    "page_timeout_ms": 25000,
    "hydration_wait_ms": 4000,
    "mobile_user_agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.5 Mobile/15E148 Safari/604.1",
    "mobile_viewport": {
      "width": 390,
      "height": 844
    },
    "thresholds": {
      "max_load_time_seconds": 6.0,
      "max_ttfb_ms": 2500,
      "max_page_weight_mb": 5.0,
      "max_dom_nodes": 1800,
      "min_dom_nodes": 250,
      "min_text_length": 600,
      "min_images_count": 2,
      "max_sticky_header_pct": 25,
      "min_rendered_dom_nodes": 80,
      "min_rendered_text_chars": 150
    },
    "generic_email_prefixes": [
      "info@",
      "contact@",
      "sales@",
      "support@",
      "admin@",
      "office@",
      "hello@",
      "team@",
      "help@",
      "billing@",
      "enquiry@"
    ],
    "form_embed_domains": [
      "form",
      "typeform",
      "hubspot",
      "jotform",
      "leadconnectorhq",
      "msgsndr",
      "calendly",
      "roofr",
      "jobnimbus",
      "acculynx",
      "housecallpro",
      "podium",
      "wufoo"
    ],
    "form_keywords": [
      "contact",
      "quote",
      "estimate",
      "schedule",
      "book",
      "request",
      "get-started",
      "consultation",
      "reach-us",
      "get-in-touch"
    ],
    "agency_credit_patterns": [
      "designed by",
      "powered by",
      "website by",
      "built by",
      "marketing by",
      "developed by",
      "seo by",
      "created by"
    ],
    "email_noise_tokens": [
      "sentry",
      "wixpress",
      "cloudflare",
      "google",
      "gstatic",
      "schema.org",
      "wordpress",
      "elementor",
      "example.com",
      "domain.com",
      "yourdomain.com",
      "email.com"
    ]
  }
}